{
  "description": "Adding to a full top 10 names the title it replaces.",
  "viewer": "alice",
  "request": {
    "method": "POST",
    "action": "top-ten",
    "path": "/api/screenr/top-ten",
    "body": {
      "title": "movie:105",
      "change": "add",
      "replace": "movie:102"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "ok": true
    }
  }
}
