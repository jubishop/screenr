<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The share extension's app group, which is also the Keychain access group
     that holds the app's session, and the directory for its log. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>$(SCREENR_APP_GROUP)</string>
  </array>
</dict>
</plist>
