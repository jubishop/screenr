{
  "name": "screenr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-database.ts && tsx --test --test-concurrency=1 tests/app/*.test.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "test:browser": "SCREENR_BROWSER_MODE=production playwright test",
    "test:browser:dev": "SCREENR_BROWSER_MODE=development playwright test",
    "test:browser:isolation": "tsx scripts/check-browser-isolation.ts",
    "format:check": "prettier --check src scripts tests/app tests/browser package.json tsconfig.json next.config.ts playwright.config.ts compose.yml",
    "dev:code": "tsx scripts/dev-code.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "release:package": "tsx scripts/package.ts"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
