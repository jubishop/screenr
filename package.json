{
  "name": "screenr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-database.ts && env -u SCREENR_TEST_SHARD tsx --test --test-concurrency=1 ${SCREENR_TEST_SHARD:+--test-shard=$SCREENR_TEST_SHARD} tests/app/*.test.ts",
    "test:coverage": "tsx scripts/test-database.ts && tsx scripts/test-coverage.ts",
    "fixtures:ios": "tsx scripts/test-database.ts && SCREENR_WRITE_IOS_FIXTURES=1 tsx --test tests/app/ios-fixtures.test.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "test:browser": "SCREENR_BROWSER_MODE=production playwright test",
    "test:browser:dev": "SCREENR_BROWSER_MODE=development playwright test",
    "test:browser:isolation": "tsx scripts/check-browser-isolation.ts",
    "format:check": "prettier --check src scripts tests/app tests/browser package.json tsconfig.json next.config.ts playwright.config.ts compose.yml",
    "dev:code": "tsx scripts/dev-code.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "report:usage": "tsx scripts/report-usage.ts",
    "seed:review": "tsx scripts/seed-review.ts",
    "release:package": "tsx scripts/package.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
