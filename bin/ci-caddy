#!/bin/sh
# Copy /usr/bin/caddy to the path given, from the image that
# .github/caddy/Dockerfile pins, for CI's proxy test. Docker Hub sometimes
# fails a pull, such as with 502 Bad Gateway (#379), so this retries the pull
# with a short backoff before failing. tests/test_ci_caddy.py exercises it.
# See docs/development-workflow.md#ci-caddy.
set -eu

destination=${1:?usage: bin/ci-caddy DESTINATION}
image=$(sed -n 's/^FROM //p' "$(dirname "$0")/../.github/caddy/Dockerfile")
test -n "$image"

attempts=4
attempt=1
until docker pull --quiet "$image"; do
    if [ "$attempt" -ge "$attempts" ]; then
        echo "Could not pull $image after $attempts attempts." >&2
        exit 1
    fi
    delay=$((attempt * 5))
    echo "Pulling $image failed; retrying in $delay seconds." >&2
    sleep "$delay"
    attempt=$((attempt + 1))
done

container=$(docker create --quiet "$image")
docker cp --quiet "$container:/usr/bin/caddy" "$destination"
docker rm "$container"
