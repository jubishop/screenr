#!/usr/bin/env python3
"""Run screenr's application checks; bin/check --full calls this after the foundation checks.

With --part, run one of the parts that CI runs as parallel jobs, optionally
one --shard of the application or browser tests. Together the parts run every
check that a full run does, except the iOS checks, which only run locally.
"""

import argparse
import os
import re
from pathlib import Path
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
import _ios_check_records as records  # noqa: E402
import _npm_packages as packages  # noqa: E402

ROOT = Path(__file__).resolve().parents[1]
PARTS = ("static", "app", "browser")
# A shebang naming fish, directly or through env, as bin/_checks.py matches the ShellCheck dialects.
FISH_SHEBANG = re.compile(rb"#![ \t]*(?:\S*/)?(?:env[ \t]+(?:-\S*[ \t]+)*)?fish(?=\s|$)")
INSTALL_HELP = "Run npm ci to install the packages that package-lock.json names, then rerun the checks."


def run(*command, env=None):
    subprocess.run(command, cwd=ROOT, check=True, env=env)


def shard(value):
    match = re.fullmatch(r"([1-9][0-9]*)/([1-9][0-9]*)", value)
    if not match or int(match[1]) > int(match[2]):
        raise argparse.ArgumentTypeError("expected I/N with 1 <= I <= N")
    return value


def arguments():
    parser = argparse.ArgumentParser(prog="check-application", description=__doc__.splitlines()[0])
    parser.add_argument("--part", choices=PARTS, help="run only this part of the checks")
    parser.add_argument("--shard", type=shard, metavar="I/N",
                        help="run only shard I of N of the app or browser part")
    args = parser.parse_args()
    if args.shard and args.part not in ("app", "browser"):
        parser.error("--shard needs --part app or --part browser")
    return args


def git(*args):
    return subprocess.run(["git", *args], cwd=ROOT, check=True, capture_output=True, text=True).stdout


def ios_checks_needed():
    """Report whether this Mac should run bin/check-ios: its files differ from where this branch left main."""
    if not shutil.which("xcodebuild"):
        print("Skipping iOS checks: they need macOS with Xcode.", flush=True)
        return False
    try:
        base = git("merge-base", "HEAD", "origin/main").strip()
    except subprocess.CalledProcessError:
        print("Running iOS checks: there is no origin/main to compare the iOS files with.", flush=True)
        return True
    # Committed, staged, and unstaged changes to tracked files, then untracked files.
    if (git("diff", "--name-only", base, "--", *records.PATHSPEC)
            or git("ls-files", "--others", "--exclude-standard", "--", *records.PATHSPEC)):
        print(f"Running iOS checks: the iOS files differ from origin/main at {base[:12]}.", flush=True)
        return True
    print(f"Skipping iOS checks: the iOS files match origin/main at {base[:12]}.", flush=True)
    return False


def main():
    args = arguments()
    # npm test runs one shard of the application tests only when --shard names it.
    os.environ.pop("SCREENR_TEST_SHARD", None)
    packages.require_node(ROOT, "application checks", "bin/check --full")
    try:
        # Stop rather than run npm ci, which would replace node_modules under a development server.
        packages.require_locked_packages(ROOT)
    except packages.StalePackages as error:
        raise RuntimeError(f"{error}\n{INSTALL_HELP}") from None
    if args.part in (None, "static"):
        scripts = [str(path) for path in sorted((ROOT / "ops").iterdir())
                   if path.is_file() and path.read_bytes().startswith(b"#!/bin/sh")]
        if scripts:
            run("shellcheck", "--shell=sh", *scripts)
        # The Sentry skills' Bash helpers source lib.sh beside them.
        helpers = [str(path) for path in sorted((ROOT / ".agents/scripts").rglob("*.sh"))]
        if helpers:
            run("shellcheck", "--shell=bash", "--external-sources", "--source-path=SCRIPTDIR", *helpers)
        # The Sentry pickers, bin/snissue and bin/snfeedback, are fish scripts, as in PodHaven.
        # fish checks only the first script it is given, so each gets its own run.
        for path in sorted((ROOT / "bin").iterdir()):
            if path.is_file() and FISH_SHEBANG.match(path.read_bytes()):
                run("fish", "--no-config", "--no-execute", str(path))
        run(sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-v")
        for script in ("format:check", "typecheck"):
            run("npm", "run", script)
    if args.part in (None, "app"):
        run("npm", "run", "test", env=os.environ | {"SCREENR_TEST_SHARD": args.shard} if args.shard else None)
    if args.part in (None, "browser"):
        # Browser validation builds and tests the current production artifact.
        run("npm", "run", "test:browser", *(["--", "--shard=" + args.shard] if args.shard else []))
    if args.part:
        print(f"Application {args.part} checks passed" + (f" (shard {args.shard})." if args.shard else "."),
              flush=True)
        return
    if ios_checks_needed():
        # A recent pass for these exact iOS files counts, and this run's pass satisfies the pre-push hook.
        run(str(ROOT / "bin/check-ios"), "--reuse")
    print("Application checks passed.", flush=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
