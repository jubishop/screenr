#!/usr/bin/env python3
"""Track every unresolved Sentry feedback item and error issue in a GitHub issue.

It files one issue per unresolved feedback item from the iPhone app's
screenr-ios project and per unresolved error issue in screenr-ios and
screenr-server, and an error that comes back after every issue that tracked
it closed gets a recurrence issue. Each tracking issue carries its
sentry-feedback or sentry-issue label, and an open one that has no findings
yet gets one comment that makes its analysis skill a fix-issue prerequisite.
Adapted from PodHaven's bin/check-sentry-feedback and bin/check-sentry-issues.

The repository is public, so an issue holds only Sentry IDs and links, and a
feedback item's date and app build. What members write, who they are, what
they attach, and what errors say stay in Sentry. See docs/ios-app.md,
"Sentry triage as in PodHaven".
"""

import argparse
from dataclasses import dataclass
from datetime import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from zoneinfo import ZoneInfo

sys.dont_write_bytecode = True
# The analysis skills' helper decides which issue tracks an item, so the intake,
# the skills, and bin/snissue and bin/snfeedback agree, and trust only issues
# that the intake's github-actions bot or the repository's owner opened.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / ".agents/scripts/sentry-cli"))
import find_tracking_issues as tracking  # noqa: E402

ORGANIZATION = "artisanal-software"
SENTRY_API = "https://us.sentry.io/api/0"
LOOKBACK = "90d"  # Sentry's event retention.
PACIFIC = ZoneInfo("America/Los_Angeles")
PRIORITY = "p2"  # Every intake issue starts here; the analysis sets it from its findings.


@dataclass(frozen=True)
class Project:
    slug: str
    id: str  # The ID in the project's DSN.
    area: str


@dataclass(frozen=True)
class Kind:
    name: str  # As find_tracking_issues.py names it.
    query: str
    label: str
    comment_marker: str
    skill: str
    command: str
    details: str


IOS = Project("screenr-ios", "4512251383513088", "area: ios")
SERVER = Project("screenr-server", "4512251383578624", "area: server")
FEEDBACK = Kind("feedback", "issue.category:feedback is:unresolved", "sentry-feedback", "sfeedback",
                "analyze-sentry-feedback", "bin/snfeedback", "Protected feedback details")
ERROR = Kind("issue", "is:unresolved !issue.category:feedback", "sentry-issue", "snissue",
             "analyze-sentry-issue", "bin/snissue", "Event details")
ERROR_PROJECTS = (IOS, SERVER)  # Feedback comes only from the app.

# Sentry values are copied into an issue only when they match these patterns,
# which no sentence of member text can.
NUMERIC_ID = re.compile(r"[0-9]+")
SHORT_ID = re.compile(r"[A-Z0-9-]+")
RELEASE = re.compile(r"[A-Za-z0-9._@+-]{1,200}")
DIST = re.compile(r"[A-Za-z0-9._-]{1,64}")

NEXT_PAGE = re.compile(r'<([^>]+)>;\s*rel="next";\s*results="true"')
ISSUE_URL = re.compile(r"https://github\.com/[^/\s]+/[^/\s]+/issues/([0-9]+)")
COMMENTS_QUERY = """query($owner: String!, $name: String!, $number: Int!, $endCursor: String) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      comments(first: 100, after: $endCursor) {
        nodes { body author { __typename login } }
        pageInfo { hasNextPage endCursor }
      }
    }
  }
}"""


@dataclass(frozen=True)
class Item:
    kind: Kind
    project: Project
    id: str
    short_id: str
    date: str | None = None  # A feedback item's Pacific date.

    @property
    def argument(self):
        """The reference that the analysis skill and its picker take."""
        return f"{self.project.slug}:{self.id}" if self.kind is FEEDBACK else self.id

    @property
    def link(self):
        if self.kind is FEEDBACK:
            return (f"https://{ORGANIZATION}.sentry.io/feedback/"
                    f"?feedbackSlug={self.project.slug}%3A{self.id}&project={self.project.id}")
        return f"https://{ORGANIZATION}.sentry.io/issues/{self.id}/"

    @property
    def link_text(self):
        return self.argument if self.kind is FEEDBACK else self.short_id


def unexpected(what):
    return RuntimeError(f"Sentry returned an unexpected {what}.")


def sentry_get(api, token, url):
    """Return a Sentry response's JSON and the URL of its next page, if any."""
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            payload = json.load(response)
            link = response.headers.get("Link") or ""
    except urllib.error.HTTPError as error:
        # The response body is not reported; it could echo feedback or an error.
        raise RuntimeError(f"Sentry returned HTTP {error.code} for "
                           f"{urllib.parse.urlsplit(url).path}.") from None
    except ValueError:
        raise unexpected("response") from None
    following = NEXT_PAGE.search(link)
    if following is None:
        return payload, None
    if urllib.parse.urlsplit(following[1]).netloc != urllib.parse.urlsplit(api).netloc:
        raise unexpected("next page")
    return payload, following[1]


def item(raw, kind, project):
    """Keep only an issue's ID and short ID, and a feedback item's Pacific date."""
    what = "feedback item" if kind is FEEDBACK else "error issue"
    try:
        issue_id, short_id = raw["id"], raw["shortId"]
        seen = datetime.fromisoformat(raw["firstSeen"]) if kind is FEEDBACK else None
    except (TypeError, KeyError, ValueError):
        raise unexpected(what) from None
    if (not isinstance(issue_id, str) or not NUMERIC_ID.fullmatch(issue_id)
            or not isinstance(short_id, str) or not SHORT_ID.fullmatch(short_id)
            or (seen is not None and seen.tzinfo is None)):
        raise unexpected(what)
    date = seen.astimezone(PACIFIC).date().isoformat() if seen else None
    return Item(kind, project, issue_id, short_id, date)


def unresolved(api, token, kind, project):
    """Return every unresolved item of one kind in one project, reading every page or failing."""
    query = urllib.parse.urlencode({"project": project.id, "query": kind.query,
                                    "statsPeriod": LOOKBACK, "limit": 100})
    url, items = f"{api}/organizations/{ORGANIZATION}/issues/?{query}", []
    while url:
        page, url = sentry_get(api, token, url)
        if not isinstance(page, list):
            raise unexpected(f"{kind.name} list")
        items.extend(item(raw, kind, project) for raw in page)
    return items


def build(api, token, issue_id):
    """Describe the app build from the feedback event's release and dist tags."""
    url = f"{api}/organizations/{ORGANIZATION}/issues/{issue_id}/events/latest/"
    event, _ = sentry_get(api, token, url)
    tags = event.get("tags") if isinstance(event, dict) else None
    values = {tag.get("key"): tag.get("value") for tag in tags
              if isinstance(tag, dict)} if isinstance(tags, list) else {}
    release, dist = values.get("release"), values.get("dist")
    if not isinstance(release, str) or not RELEASE.fullmatch(release):
        return "unknown"
    if isinstance(dist, str) and DIST.fullmatch(dist):
        return f"`{release}` (dist `{dist}`)"
    return f"`{release}`"


def feedback_body(entry, app_build):
    return (f"<!-- sentry-feedback:{entry.argument} -->\n"
            f"- **Feedback:** [{entry.short_id}]({entry.link})\n"
            f"- **Date:** {entry.date} (Pacific)\n"
            f"- **Build:** {app_build}\n"
            "\n"
            "This repository is public. Read the feedback in Sentry, and describe it here "
            "only in paraphrase without names.\n")


def error_body(entry, earlier=()):
    """Describe an error issue by its linked short ID alone, and name any earlier tracking issues."""
    lines = [f"<!-- sentry-issue:{entry.id} -->"]
    if earlier:
        lines += ["An unresolved Sentry issue needs triage again after its tracking issues closed.", "",
                  f"- **Sentry issue:** [{entry.short_id}]({entry.link})",
                  f"- **Earlier tracking issues:** {', '.join(f'#{number}' for number in earlier)}"]
    else:
        lines += ["An unresolved Sentry issue needs triage.", "",
                  f"- **Sentry issue:** [{entry.short_id}]({entry.link})"]
    lines += ["", "Event details remain in Sentry because this repository is public."]
    return "\n".join(lines) + "\n"


def comment_marker(entry):
    return f"<!-- {entry.kind.comment_marker}:{entry.argument} -->"


def instructions(entry):
    """Return the comment that tells agents to analyze an item before implementing anything."""
    kind = entry.kind
    return (f"{comment_marker(entry)}\n"
            f"<!-- fix-issue-prerequisite: {kind.skill} {entry.argument} -->\n"
            "This issue is intake only and must be analyzed before implementation.\n"
            "\n"
            f"- Run `{kind.command} {entry.argument}` from a Screenr checkout to analyze it directly.\n"
            "- If passed to `fix-issue`, it will run the same analysis prerequisite, refresh this issue, "
            "and then continue from the findings.\n"
            "\n"
            f"{kind.details} remain in Sentry: [{entry.link_text}]({entry.link}).\n")


def gh(*args, body=None):
    return subprocess.run(["gh", *args], input=body, stdin=None if body is not None else subprocess.DEVNULL,
                          check=True, stdout=subprocess.PIPE, text=True, timeout=120).stdout


def labels(issue):
    try:
        return {node["name"] for node in issue["labels"]["nodes"]}
    except (TypeError, KeyError):
        raise RuntimeError("gh returned an unexpected issue list.") from None


class Intake:
    def __init__(self, api, token, repository, dry_run):
        self.api, self.token, self.repository, self.dry_run = api, token, repository, dry_run
        self.owner, _, self.name = repository.partition("/")
        self.filed = {"feedback": 0, "error": 0, "recurrence": 0}
        self.tracked = self.labeled = self.commented = 0

    def run(self, items):
        found = tracking.issues(self.repository) if items else []
        for entry in items:
            matches, _ = tracking.matches(entry.kind.name, entry.id, found, self.owner)
            open_matches = [match for match in matches if match[0]["state"] == "OPEN"]
            if entry.kind is FEEDBACK and matches:
                # One report: its issue, open or closed, stays its record.
                self.track(entry, tracking.canonical(matches))
            elif entry.kind is FEEDBACK:
                body = feedback_body(entry, build(self.api, self.token, entry.id))
                self.file(entry, "feedback", f"Triage Sentry feedback {entry.short_id}", body)
            elif open_matches:
                self.track(entry, tracking.canonical(open_matches))
            elif matches:
                # Never reopen a closed issue: its PR and closeout record what shipped.
                earlier = sorted(issue["number"] for issue, _ in matches)
                self.file(entry, "recurrence", f"Triage recurrence of Sentry issue {entry.short_id}",
                          error_body(entry, earlier))
            else:
                self.file(entry, "error", f"Triage Sentry issue {entry.short_id}", error_body(entry))

    def file(self, entry, counter, title, body):
        self.filed[counter] += 1
        if self.dry_run:
            print(f"Would file: {title}")
            self.comment(None, entry)
            return
        names = ("investigation", entry.project.area, entry.kind.label, PRIORITY)
        url = gh("issue", "create", "--repo", self.repository, "--title", title, "--body-file", "-",
                 *[argument for name in names for argument in ("--label", name)], body=body).strip()
        number = ISSUE_URL.fullmatch(url)
        if number is None:
            raise RuntimeError("gh returned an unexpected issue URL.")
        print(f"Filed {url} for {entry.short_id}")
        self.comment(int(number[1]), entry)

    def track(self, entry, issue):
        """Label an item's tracking issue, and leave instructions on it until it is analyzed."""
        self.tracked += 1
        number = issue["number"]
        if entry.kind.label not in labels(issue):
            self.labeled += 1
            if self.dry_run:
                print(f"Would add the {entry.kind.label} label to #{number}")
            else:
                gh("issue", "edit", str(number), "--repo", self.repository, "--add-label", entry.kind.label)
                print(f"Added the {entry.kind.label} label to #{number}")
        block = tracking.patterns(entry.kind.name, entry.id)[2]
        if (issue["state"] == "OPEN"
                and tracking.analysis(entry.kind.name, issue.get("body") or "", block) == "not analyzed"
                and not self.instructed(number, comment_marker(entry))):
            self.comment(number, entry)
        print(f"Already tracked: {entry.short_id} in #{number}")

    def instructed(self, number, marker):
        """Report whether the intake's bot or the owner already left an item's instructions on an issue."""
        pages = json.loads(gh("api", "graphql", "--paginate", "--slurp", "-f", f"owner={self.owner}",
                              "-f", f"name={self.name}", "-F", f"number={number}",
                              "-f", f"query={COMMENTS_QUERY}"))
        return any(marker in (comment.get("body") or "") and tracking.trusted(comment.get("author"), self.owner)
                   for page in pages for comment in page["data"]["repository"]["issue"]["comments"]["nodes"])

    def comment(self, number, entry):
        self.commented += 1
        if self.dry_run:
            target = f"#{number}" if number else f"the new issue for {entry.short_id}"
            print(f"Would add the instruction comment to {target}")
            return
        gh("issue", "comment", str(number), "--repo", self.repository, "--body-file", "-", body=instructions(entry))
        print(f"Added the instruction comment to #{number}")

    def summary(self, feedback, errors):
        filed, added = ("Would file", "would add") if self.dry_run else ("Filed", "added")
        return (f"Found {feedback} unresolved feedback item(s) and {errors} unresolved error issue(s); "
                f"{self.tracked} already tracked.\n"
                f"{filed} {self.filed['feedback']} feedback issue(s), {self.filed['error']} error issue(s), "
                f"and {self.filed['recurrence']} recurrence issue(s); "
                f"{added} {self.labeled} label(s) and {self.commented} instruction comment(s).\n")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true",
                        help="print what it would file, label, and comment on, and write nothing to GitHub")
    args = parser.parse_args()
    token = os.environ.get("SENTRY_AUTH_TOKEN")
    if not token:
        raise RuntimeError("SENTRY_AUTH_TOKEN is required.")
    api = os.environ.get("SENTRY_API_URL", SENTRY_API).rstrip("/")
    repository = os.environ.get("GH_REPO") or "jubishop/screenr"

    # Read every list before acting, so a failure acts on no partial list.
    feedback = sorted(unresolved(api, token, FEEDBACK, IOS), key=lambda entry: int(entry.id))
    errors = sorted((entry for project in ERROR_PROJECTS for entry in unresolved(api, token, ERROR, project)),
                    key=lambda entry: int(entry.id))
    intake = Intake(api, token, repository, args.dry_run)
    intake.run(feedback + errors)

    summary = intake.summary(len(feedback), len(errors))
    print(summary, end="")
    if os.environ.get("GITHUB_STEP_SUMMARY"):
        with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as output:
            output.write(f"## Sentry intake\n\n{summary}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, KeyError, TypeError, ValueError, RuntimeError,
            subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
