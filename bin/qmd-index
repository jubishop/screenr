#!/usr/bin/env python3
"""Refresh this checkout's QMD index, with one writer at a time."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--background", action="store_true")
    args = parser.parse_args()

    script = Path(__file__).resolve()
    repo_root = script.parent.parent
    config_dir = repo_root / ".config" / "qmd"
    shared_config = config_dir / "collections.json"
    if not shared_config.is_file():
        return 0

    cache_dir = repo_root / ".cache" / "qmd"
    cache_dir.mkdir(parents=True, exist_ok=True)

    if args.background:
        with (cache_dir / "index.log").open("a") as log:
            subprocess.Popen(
                [sys.executable, str(script)],
                cwd=repo_root,
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        return 0

    env = os.environ.copy()
    env.update(
        QMD_CONFIG_DIR=str(config_dir),
        XDG_CACHE_HOME=str(repo_root / ".cache"),
        INDEX_PATH=str(cache_dir / "index.sqlite"),
    )
    with (cache_dir / "index.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            config = json.loads(shared_config.read_text())
            setting = subprocess.run(
                ["git", "config", "--local", "--get", "screenr.homeMemoryPath"],
                cwd=repo_root, text=True, capture_output=True,
            )
            if setting.returncode not in (0, 1):
                print(setting.stderr, file=sys.stderr)
                return setting.returncode
            if setting.returncode == 0:
                home_memory = Path(setting.stdout.strip()).expanduser()
                if not home_memory.is_absolute():
                    print("screenr.homeMemoryPath must be an absolute path.", file=sys.stderr)
                    return 1
                if home_memory.is_dir():
                    config["collections"]["home-memory"] = {
                        "path": str(home_memory), "pattern": "**/*.md",
                    }
                else:
                    print(f"Home memory is not a directory; skipping: {home_memory}", file=sys.stderr)
            # JSON is valid YAML. Generate atomically so readers see a full config.
            rendered = json.dumps(config, indent=2) + "\n"
            config_path = config_dir / "index.yml"
            if not config_path.exists() or config_path.read_text() != rendered:
                with tempfile.NamedTemporaryFile(mode="w", dir=config_dir, delete=False) as output:
                    temporary_path = Path(output.name)
                    output.write(rendered)
                try:
                    temporary_path.replace(config_path)
                finally:
                    temporary_path.unlink(missing_ok=True)

            qmd = shutil.which("qmd")
            if qmd is None:
                print("qmd not found; skipping the local search index.", file=sys.stderr)
                return 0
            for command in ("update", "embed"):
                subprocess.run([qmd, command], cwd=repo_root, env=env, check=True)
        except subprocess.CalledProcessError as error:
            print(f"QMD refresh failed: {error}", file=sys.stderr)
            return error.returncode if error.returncode > 0 else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
