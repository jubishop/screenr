#!/usr/bin/env python3
"""Deploy the checked main revision from the GitHub Actions production job.

The deploy key can run only ops/receive-release on the host, so every remote
step is one of its commands. Root runs the deploy kit that
bin/install-deploy-kit installed from Git; this helper sends only the release
archive and the kit digest that the checked revision expects.
"""
import hashlib
import json
import os
import posixpath
from pathlib import Path, PurePosixPath
import re
import subprocess
import sys
import tarfile

from _deploy_kit import checked_kit, kit_digest

REPO = 'jubishop/screenr'
ROOT = Path(__file__).resolve().parents[1]
# The remote scripts exit with this status when no healthy release is running.
PRODUCTION_DOWN = 69


def run(*args, capture=False, text=True, stdin=None):
    if args[0] == 'ssh':
        args = (args[0], '-i', os.environ['SCREENR_DEPLOY_KEY_FILE'],
                '-o', 'UserKnownHostsFile=' + os.environ['SCREENR_DEPLOY_KNOWN_HOSTS_FILE'],
                '-o', 'StrictHostKeyChecking=yes', '-o', 'IdentitiesOnly=yes',
                '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
                '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=3', *args[1:])
    if stdin is None:
        return subprocess.run(args, check=True, text=text, cwd=ROOT, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE if capture else None).stdout
    with stdin.open('rb') as data:
        return subprocess.run(args, check=True, cwd=ROOT, stdin=data).stdout


def contains(older, newer):
    """Report whether newer equals older or descends from it, using GitHub history."""
    try:
        comparison = json.loads(run('gh', 'api', f'repos/{REPO}/compare/{older}...{newer}?per_page=1',
                                    capture=True))
        return comparison['status'] in ('identical', 'ahead')
    except (subprocess.SubprocessError, ValueError, KeyError, TypeError) as error:
        raise ValueError(f'Could not compare {older} with {newer}.') from error


def host_status(host):
    """Return the active production revision, or None on a new host, and the installed kit digest."""
    try:
        status = json.loads(run('ssh', host, 'status', capture=True))
        active, kit = status['active'], status['kit']
    except (subprocess.SubprocessError, ValueError, KeyError, TypeError) as error:
        raise ValueError('Could not read the active production revision.') from error
    if active is not None and not (isinstance(active, str) and re.fullmatch(r'[0-9a-f]{40}', active)):
        raise ValueError('Could not read the active production revision.')
    if not (isinstance(kit, str) and re.fullmatch(r'[0-9a-f]{64}', kit)):
        raise ValueError('Could not read the deploy kit installed on the host.')
    return active, kit


def check_release(revision, host, kit):
    """Require the installed kit to match, main to contain the release, and the release to contain production."""
    if not contains(revision, 'main'):
        raise ValueError(f'Release {revision} is not in main. Deploy a revision that main contains.')
    active, installed = host_status(host)
    if installed != kit:
        raise ValueError(f'The deploy kit on the host ({installed[:12]}) does not match ops/ at {revision} '
                         f'({kit[:12]}). From a trusted checkout, run bin/install-deploy-kit root@HOST {revision}, '
                         'then re-run the failed deploy job.')
    if active is None:
        print(f'Main contains {revision}; production has no active release, '
              'so this is the first deployment.', flush=True)
        return
    if not contains(active, revision):
        raise ValueError(f'Release {revision} does not contain production revision {active}. '
                         'Production never moves backwards.')
    print(f'Main contains {revision}; production has {active}.', flush=True)


def main():
    if (os.environ.get('GITHUB_REPOSITORY') != REPO or
            os.environ.get('GITHUB_EVENT_NAME') not in {'push', 'workflow_dispatch'} or
            os.environ.get('GITHUB_REF') != 'refs/heads/main'):
        raise ValueError('Production deployment requires a push or manual workflow on jubishop/screenr main.')
    run_id = os.environ.get('GITHUB_RUN_ID', '')
    revision = os.environ.get('GITHUB_SHA', '')
    host = os.environ.get('SCREENR_DEPLOY_HOST', '')
    if not run_id.isdecimal() or not re.fullmatch(r'[0-9a-f]{40}', revision):
        raise ValueError('Invalid GitHub run or revision.')
    if not re.fullmatch(r'root@[A-Za-z0-9][A-Za-z0-9.-]*', host):
        raise ValueError('Set SCREENR_DEPLOY_HOST to the root SSH destination in the production environment.')
    for name in ('SCREENR_DEPLOY_KEY_FILE', 'SCREENR_DEPLOY_KNOWN_HOSTS_FILE'):
        if not os.environ.get(name) or not Path(os.environ[name]).is_file():
            raise ValueError(f'Missing SSH configuration: {name}')
    info = json.loads(run('gh', 'api', f'repos/{REPO}/actions/runs/{run_id}', capture=True))
    if (info.get('head_branch'), info.get('event'), info.get('path'), info.get('head_sha')) != (
            'main', os.environ['GITHUB_EVENT_NAME'], '.github/workflows/check.yml', revision):
        raise ValueError('Deployment requires the matching main workflow.')
    jobs = json.loads(run('gh', 'api', f'repos/{REPO}/actions/runs/{run_id}/jobs', capture=True))['jobs']
    if not any(job['name'] == 'check' and job.get('conclusion') == 'success' for job in jobs):
        raise ValueError('The release checks must pass before deployment.')
    if run('git', 'rev-parse', 'HEAD', capture=True).strip() != revision:
        raise ValueError('Checkout does not match the checked revision.')
    # Root and the backup services run only the deploy kit on the host. Its
    # digest comes from Git, never from the checkout's working files.
    kit = kit_digest(checked_kit(run('git', 'archive', '--format=tar', revision, 'ops/',
                                     capture=True, text=False)))
    check_release(revision, host, kit)
    artifact_name = f'screenr-linux-x64-{revision}'
    print(f'Deploying {revision} from run {run_id}', flush=True)
    directory = ROOT / '.cache' / 'deploy' / run_id
    directory.mkdir(parents=True, exist_ok=True)
    archive = directory / f'screenr-{revision}.tar.gz'
    run('gh', 'run', 'download', run_id, '--repo', REPO, '--name', artifact_name, '--dir', str(directory))
    with tarfile.open(archive) as release:
        members = release.getmembers()
        for member in members:
            path = PurePosixPath(member.name)
            if path.is_absolute() or '..' in path.parts or member.isdev() or member.isfifo():
                raise ValueError('Unsafe archive member.')
            if member.issym() or member.islnk():
                target = PurePosixPath(member.linkname)
                combined = posixpath.normpath(str(path.parent / target) if member.issym() else str(target))
                if target.is_absolute() or combined == '..' or combined.startswith('../'):
                    raise ValueError('Escaping archive link.')
        for required in ('REVISION', 'server.js'):
            if not any(str(PurePosixPath(m.name)) == required and m.isfile() for m in members):
                raise ValueError(f'Missing release file: {required}')
        manifest = next(m for m in members if str(PurePosixPath(m.name)) == 'REVISION')
        if not manifest.isfile() or release.extractfile(manifest).read().decode().strip() != revision:
            raise ValueError('Archive revision does not match checked revision.')
    artifacts = json.loads(run('gh', 'api', f'repos/{REPO}/actions/runs/{run_id}/artifacts', capture=True))
    for artifact in artifacts['artifacts']:
        if artifact['name'] == artifact_name:
            run('gh', 'api', '--method', 'DELETE', f"repos/{REPO}/actions/artifacts/{artifact['id']}")
    checksum = hashlib.sha256(archive.read_bytes()).hexdigest()
    try:
        # The receiver checks the archive again and keeps it only if it passes.
        try:
            run('ssh', host, f'upload {revision} {checksum}', stdin=archive)
        except subprocess.CalledProcessError as error:
            raise ValueError(f'The host refused the upload with status {error.returncode}; '
                             'see its output above.') from error
        check_release(revision, host, kit)
        try:
            run('ssh', host, f'deploy {revision} {checksum} {kit}')
        except subprocess.CalledProcessError as error:
            if error.returncode == PRODUCTION_DOWN:
                raise ValueError('Activation failed and no healthy release is running, so production is down. '
                                 'Follow the recovery steps in docs/deployment.md.') from error
            raise ValueError(f'Remote deployment exited with status {error.returncode}; '
                             'see its output above.') from error
    finally:
        try:
            run('ssh', host, 'discard')
        except subprocess.SubprocessError:
            print('Could not remove the uploaded archive from the host.', file=sys.stderr)
    for path in ('api/health', 'login', 'api/auth/get-session'):
        body = run('curl', '--fail', '--silent', '--show-error', '--max-time', '20',
                   f'https://screenr.club/{path}', capture=True)
        if path == 'api/health' and json.loads(body).get('ok') is not True:
            raise ValueError('Public health check failed.')
        if path == 'login' and 'Send sign-in code' not in body:
            raise ValueError('Public login check failed.')
        # The login page renders without the auth handler; a signed-out
        # session request proves the sign-in route itself answers.
        if path == 'api/auth/get-session' and body.strip() != 'null':
            raise ValueError('Public sign-in check failed.')
    run('ssh', host, f'finalize {revision}')
    print(f'DEPLOY SUCCEEDED: {revision}\nhttps://screenr.club')
    print('Verify changed user flows and the other shared-host applications before closing the release.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, StopIteration, tarfile.TarError, subprocess.SubprocessError) as error:
        print(f'DEPLOY FAILED: {error}', file=sys.stderr)
        sys.exit(1)
