#!/bin/sh
# Prepare only a new branch checkout; leave normal direnv checks intact.
set -eu

repo_root=$(git rev-parse --show-toplevel)
if [ "${3:-0}" = 1 ]; then
  case "${1:-}" in
    ""|*[!0]*) ;;
    *) "$repo_root/bin/prep-worktree" "$repo_root" ;;
  esac
fi

if [ -x "$repo_root/bin/qmd-index" ]; then
  "$repo_root/bin/qmd-index" --background
fi
