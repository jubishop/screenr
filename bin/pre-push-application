#!/usr/bin/env python3
"""Refuse a push whose iOS files have not passed bin/check-ios on this Mac.

Git passes one line per ref on standard input: local ref, local commit,
remote ref, remote commit. The hook refuses a push whose lines it cannot read.
A pushed branch changes the iOS files when they differ from the remote
branch's commit, or, for a new branch, from where it left origin/main. The
hook accepts those files only with a recorded bin/check-ios pass with the same
Xcode, and otherwise refuses the push at once, saying how to record one. It
never runs the check itself: Git connects to the remote before it runs this
hook, and GitHub closes an idle SSH connection long before a full check
finishes, so a push that waited for the check failed after the check passed
(#549). Tag pushes, branch deletions, and hosts without xcodebuild, such as
Linux and CI, skip it. See
docs/development-workflow.md#ios-checks-before-a-push.

Project Starter's managed bin/hooks/pre-push runs this file from the pushing
checkout, after its document checks pass, with Git's arguments, standard
input, and environment, so each worktree runs its own copy.
"""

from pathlib import Path
import re
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import _ios_check_records as records  # noqa: E402

ADVICE = "Never bypass this check with git push --no-verify."


def say(message):
    print(f"pre-push: {message}", file=sys.stderr, flush=True)


def absent(commit):
    return set(commit) == {"0"}


def exists(root, commit):
    return subprocess.run(["git", "cat-file", "-e", f"{commit}^{{commit}}"], cwd=root,
                          capture_output=True).returncode == 0


def base_key(root, local, remote):
    """The iOS files the push replaces: the remote branch's, or origin/main's at the fork point."""
    if not absent(remote) and exists(root, remote):
        return records.files_key(root, remote)
    try:
        base = records.git(root, "merge-base", local, "refs/remotes/origin/main").strip()
    except (OSError, subprocess.CalledProcessError):
        return "no base"
    return records.files_key(root, base)


def changed_files(root, lines):
    """Map each new iOS files key to the branches that push it."""
    pending = {}
    for line in lines:
        # Git passes the local ref as typed, such as ":/Fix the layout", so only it can hold spaces.
        fields = line.rsplit(" ", 3)
        if (len(fields) != 4 or not fields[0] or not fields[2]
                or not all(re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", fields[i]) for i in (1, 3))):
            raise ValueError(f"cannot read the pushed refs from {line!r}")
        _, local, remote_ref, remote = fields
        if absent(local) or not remote_ref.startswith("refs/heads/"):
            continue
        key = records.files_key(root, local)
        if key and key != base_key(root, local, remote):
            pending.setdefault(key, []).append(remote_ref.removeprefix("refs/heads/"))
    return pending


def main():
    lines = sys.stdin.read().splitlines()
    if not shutil.which("xcodebuild"):
        return 0
    root = Path(records.git(Path.cwd(), "rev-parse", "--show-toplevel").strip())
    pending = changed_files(root, lines)
    if not pending:
        return 0
    xcode = records.xcode_version()
    unchecked = {}
    for key, branches in pending.items():
        found = records.passed(root, key, xcode)
        if found:
            say(f"the iOS files in {', '.join(branches)} passed bin/check-ios with {xcode} at "
                f"{found['passedAt']}.")
        else:
            unchecked[key] = branches
    if not unchecked:
        return 0
    names = ", ".join(name for branches in unchecked.values() for name in branches)
    if list(unchecked) == [records.working_key(root)]:
        steps = "Run bin/check-ios in this checkout, which records its pass, then push again."
    else:
        steps = ("This checkout's iOS files differ from the pushed commit, so check out the commit you are "
                 "pushing with no uncommitted iOS changes, run bin/check-ios there, which records its pass, "
                 "then push again.")
    say(f"{names} changes the iOS files (ios/ except Markdown directly in it, and bin/format-swift), but "
        f"no bin/check-ios pass with {xcode or 'this Xcode'} in the last {records.LIFETIME.days} days "
        "covers them, so the push stopped before sending anything. The hook does not run the check "
        "itself, since Git has already connected to the remote, and GitHub closes an idle SSH connection "
        f"before a full check finishes. {steps} {ADVICE}")
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", None)
        say("\n".join(str(part).strip() for part in (error, detail) if part) + "\n" + ADVICE)
        sys.exit(1)
