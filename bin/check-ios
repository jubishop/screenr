#!/usr/bin/env python3
"""Build and test the iPhone app, failing on any warning.

Runs ScreenrKit's tests with swift test on the Mac, builds the Release variant
for the Simulator, then boots an iPhone Simulator, waits for it to finish
booting, marks the keyboard's one-time slide-to-type introduction as shown,
and runs the Screenr scheme's tests (ScreenrKit and the UI tests) in it.
Without --simulator, the check creates its own Simulator and deletes it
afterward, so concurrent checkouts never share one.
Build output, logs, and result bundles stay in ios/build/, which Git ignores.
The package and app builds there are removed before building when
ios/ScreenrKit/Package.resolved, or the package sources they used, differ from
the ones they were built with.

xcodebuild's package sources and both tools' package downloads are in the
Mac's shared package cache, outside every checkout (bin/_ios_packages.py).
After taking its slot, a check resolves its packages there, under the cache's
lock, and holds the cache in use until it exits. After the package tests, it
makes the package artifacts that SwiftPM extracted into the checkout APFS
clones of the cache's identical files. The cache is in
~/Library/Caches/screenr-ios-packages, or in SCREENR_IOS_PACKAGE_CACHE, which
tests set.

At most SLOTS checks run at once on the Mac. Before its first step, a check
waits for a free slot, saying so, and holds it until it exits. The slots are
lock files in /tmp, or in SCREENR_CHECK_IOS_SLOT_DIR, which tests set.

A failing test reports at once, without collecting a sysdiagnose. Each step
runs in its own process group, and a step that outlasts its time limit, such
as --test-timeout for the Simulator tests, or an interrupted check, stops that
whole group. A tool call, such as xcrun simctl create, that has not finished
within TOOL_TIMEOUT_SECONDS is stopped, and the check fails with its command.
Shutting down and deleting the check's Simulator have the same limit but never
change the check's result: a Simulator it could not delete is reported with
its UDID. Before it creates its Simulator, a check deletes, the same way, those
that earlier checks left behind: each is named for its check's process ID, and
one whose ID no process holds is left over. One whose ID is in use may be
another checkout's running check, so it stays.

UI tests that need a push, which a test cannot send, write its payload to the
push relay directory, and the check delivers it to the Simulator with xcrun
simctl push while the tests run. A push that simctl has not sent within
PUSH_TIMEOUT_SECONDS is stopped, and the test that asked for it fails with
that reason.

A pass on a checkout whose iOS files match HEAD is recorded for those exact
files and this Xcode. With --reuse, the check skips itself when such a pass
is recent; the pre-push hook and bin/ios-testflight rely on the same records.
"""

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time

sys.dont_write_bytecode = True
import _ios_check_records as records  # noqa: E402
import _ios_packages as packages  # noqa: E402

ROOT = Path(__file__).resolve().parents[1]
BUILD = ROOT / "ios/build"
OUTPUT = BUILD / "check"
# swift test's scratch directory and xcodebuild's derived data build on their
# last run's modules. After a package update, such as a sentry-cocoa bump,
# those modules fail to load against the new framework headers, so both
# directories start over when Package.resolved changes, and when the package
# sources move, as they did from each checkout's own copy in
# DerivedData/SourcePackages to the shared cache. The stamp holds the hash of
# the Package.resolved they were built with and the sources directory.
PACKAGE_BUILDS = (BUILD / "ScreenrKit", BUILD / "DerivedData")
PACKAGE_STAMP = BUILD / "packages.stamp"
MINIMUM_XCODE = 27
# The Simulator tests took 13 minutes on the user's Mac on 2026-10-14, and 30
# on 2026-11-01 once the UI tests audited one check at a time; a run that takes
# much longer is stuck.
TEST_TIMEOUT_MINUTES = 60
BOOT_TIMEOUT_MINUTES = 10
# The ScreenrKit tests and the Release build each took about 40 seconds from an
# empty build directory on the user's Mac on 2026-11-05, at a load average near
# 40, and under a minute with a build in place. Simulators booting for other
# checks push the load to 100 or even 300, so this leaves room for a much slower
# run; one that takes longer is stuck. Tests shorten it with
# SCREENR_CHECK_IOS_BUILD_TIMEOUT.
BUILD_TIMEOUT_MINUTES = float(os.environ.get("SCREENR_CHECK_IOS_BUILD_TIMEOUT", 30))
# simctl's create and delete, and xcresulttool's reads of a Release build's
# result bundle, each took under a second on 2026-11-05 at load averages of 100
# to 140, but Simulator tools can hang under heavy load. Tests shorten this with
# SCREENR_CHECK_IOS_TOOL_TIMEOUT.
TOOL_TIMEOUT_SECONDS = float(os.environ.get("SCREENR_CHECK_IOS_TOOL_TIMEOUT", 300))
# With five or more checks at once, the Mac's load average passed 200, and the
# UI tests' accessibility audits timed out or measured contrast wrongly. Three
# kept it below 30 on 2026-10-14. Building loads the Mac too, so a slot covers
# the whole check.
SLOTS = 3
SLOT_DIRECTORY = Path(os.environ.get("SCREENR_CHECK_IOS_SLOT_DIR", "/tmp"))
SLOT_POLL_SECONDS = 2
# How long a stopped step's processes get to exit before SIGKILL.
STOP_GRACE_SECONDS = 5
# UI tests ask for a push by writing its payload to <name>.json here, which the
# check sends to Screenr Dev with xcrun simctl push and then renames to
# <name>.sent, or to <name>.failed with simctl's output or why it stopped simctl.
# xcodebuild passes the directory to the tests in SCREENR_PUSH_RELAY. It is
# inside OUTPUT, which each run removes.
PUSH_RELAY = OUTPUT / "push-relay"
PUSH_TOPIC = "com.artisanalsoftware.Screenr.dev"
PUSH_POLL_SECONDS = 0.5
# How long simctl gets to send a push, since Simulator tools can hang under
# heavy load. A push it has not sent by then fails, so the relay always finishes
# once the tests end. This is shorter than the 30 seconds that
# ios/ScreenrUITests/PushRelay.swift waits, so the waiting test reports this
# reason. Tests shorten it with SCREENR_CHECK_IOS_PUSH_TIMEOUT.
PUSH_TIMEOUT_SECONDS = float(os.environ.get("SCREENR_CHECK_IOS_PUSH_TIMEOUT", 20))
# Each check names its Simulator screenr-check-<checkout>-<pid> after its own
# process ID, so a later check can tell whether the check that made it has ended.
CHECK_SIMULATOR = re.compile(r"screenr-check-.+-(?P<pid>\d+)")
WARNING =re.compile(r"warning:", re.IGNORECASE)
# The App Intents extractor prints this for targets that do not link App
# Intents. It is not a build diagnostic, and result bundles do not count it.
NOT_A_WARNING = re.compile(
    r"appintentsmetadataprocessor\[\d+:\d+\] warning: Metadata extraction skipped, "
    r"no AppIntents\.framework dependency found$")
# A macOS SDKROOT exported by a shell profile reaches clang through xcodebuild
# and makes it warn while linking Simulator test bundles. Git's repository
# variables, such as the GIT_DIR that Git exports to hooks in a linked
# worktree, would send SwiftPM's package checkouts to this repository.
ENVIRONMENT = {key: value for key, value in records.outside_git().items() if key != "SDKROOT"}
XCODEBUILD = ["xcodebuild", "-hideShellScriptEnvironment", "-project", "ios/Screenr.xcodeproj",
              "-scheme", "Screenr", "-derivedDataPath", str(BUILD / "DerivedData"),
              *packages.xcodebuild_options(ROOT)]


class CheckFailure(Exception):
    pass


def call(command):
    """Run a tool with its output captured, and stop it if it outlasts TOOL_TIMEOUT_SECONDS.

    xcrun replaces itself with the tool it runs, so the timeout's SIGKILL
    stops the tool itself.
    """
    return subprocess.run(command, cwd=ROOT, env=ENVIRONMENT, capture_output=True, text=True,
                          timeout=TOOL_TIMEOUT_SECONDS)


def stopped(command):
    return (f"{shlex.join(command)} did not finish within {TOOL_TIMEOUT_SECONDS:g} seconds, "
            "so bin/check-ios stopped it.")


def capture(*command):
    """Return a tool's output, and fail the check when the tool fails or outlasts TOOL_TIMEOUT_SECONDS."""
    try:
        result = call(command)
    except subprocess.TimeoutExpired:
        raise CheckFailure(stopped(command)) from None
    if result.returncode:
        raise subprocess.CalledProcessError(result.returncode, command, result.stdout, result.stderr)
    return result.stdout


def stop(process):
    """End a step's process group: SIGTERM, then SIGKILL for whatever is left after the grace period."""
    deadline = time.monotonic() + STOP_GRACE_SECONDS
    for stop_signal in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(process.pid, stop_signal)
            while time.monotonic() < deadline:
                process.poll()
                time.sleep(0.1)
                os.killpg(process.pid, 0)
        except ProcessLookupError:
            return
        except PermissionError:
            continue


def run(label, command, timeout_minutes=None, environment=None):
    """Run a step with its output in a log, and fail on an error status, a warning line, or a timeout."""
    print(f"==> {label}", flush=True)
    log = OUTPUT / (label.lower().replace(" ", "-") + ".log")
    warnings = []
    expired = threading.Event()
    with log.open("w") as stream:
        # Its own process group, so stopping the step reaches every process it started.
        process = subprocess.Popen(command, cwd=ROOT, env=ENVIRONMENT | (environment or {}), text=True,
                                   start_new_session=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        watchdog = None
        if timeout_minutes:
            def expire():
                if process.poll() is None:
                    expired.set()
                    stop(process)
            watchdog = threading.Timer(timeout_minutes * 60, expire)
            watchdog.daemon = True
            watchdog.start()
        try:
            for line in process.stdout:
                stream.write(line)
                if WARNING.search(line) and not NOT_A_WARNING.search(line.rstrip()):
                    warnings.append(line.rstrip())
            status = process.wait()
        except BaseException:
            stop(process)
            raise
        finally:
            if watchdog:
                watchdog.cancel()
    if expired.is_set():
        tail = log.read_text().splitlines()[-40:]
        raise CheckFailure("\n".join([*tail, f"{label}: stopped after {timeout_minutes:g} minutes without "
                                             f"finishing; see {log}"]))
    if status:
        tail = log.read_text().splitlines()[-40:]
        raise CheckFailure("\n".join([*tail, f"{label} failed with status {status}; see {log}"]))
    if warnings:
        raise CheckFailure("\n".join([*warnings, f"{label} reported {len(warnings)} warning(s); see {log}"]))


def check_results(label, bundle, tests):
    """Require a clean build, and for test runs, at least one test with none failed or skipped."""
    build = json.loads(capture("xcrun", "xcresulttool", "get", "build-results", "--path", str(bundle)))
    counts = {key: build.get(key) for key in ("errorCount", "warningCount", "analyzerWarningCount")}
    problems = [f"{key} is {value}" for key, value in counts.items() if value != 0]
    if tests:
        summary = json.loads(capture("xcrun", "xcresulttool", "get", "test-results", "summary",
                                     "--path", str(bundle)))
        if summary.get("result") != "Passed" or summary.get("failedTests") != 0:
            problems.append(f"the result is {summary.get('result')} with "
                            f"{summary.get('failedTests')} failed test(s)")
        if summary.get("skippedTests") != 0:
            problems.append(f"{summary.get('skippedTests')} test(s) were skipped")
        if not summary.get("passedTests"):
            problems.append("no tests passed")
    if problems:
        raise CheckFailure(f"{label}: " + "; ".join(problems) + f"; see {bundle}")


class PushRelay:
    """Deliver the pushes UI tests ask for to the Simulator while the block runs."""

    def __init__(self, udid):
        self.udid = udid
        self.stopped = threading.Event()
        self.thread = threading.Thread(target=self.relay, daemon=True)

    def __enter__(self):
        PUSH_RELAY.mkdir(parents=True, exist_ok=True)
        self.thread.start()
        return self

    def __exit__(self, *exception):
        self.stopped.set()
        # A push in flight ends within its timeout; the grace covers stopping it and saying why.
        self.thread.join(PUSH_TIMEOUT_SECONDS + STOP_GRACE_SECONDS)

    def relay(self):
        while not self.stopped.wait(PUSH_POLL_SECONDS):
            for request in sorted(PUSH_RELAY.glob("*.json")):
                self.send(request)

    def send(self, request):
        try:
            # xcrun replaces itself with simctl, so the timeout's SIGKILL stops simctl itself.
            result = subprocess.run(["xcrun", "simctl", "push", self.udid, PUSH_TOPIC, str(request)],
                                    cwd=ROOT, env=ENVIRONMENT, capture_output=True, text=True,
                                    timeout=PUSH_TIMEOUT_SECONDS)
            outcome = ".sent" if result.returncode == 0 else ".failed"
            output = result.stdout + result.stderr
        except subprocess.TimeoutExpired:
            outcome = ".failed"
            output = f"it did not finish within {PUSH_TIMEOUT_SECONDS:g} seconds, so bin/check-ios stopped it\n"
        request.with_suffix(outcome).write_text(output)
        request.unlink()


def lock_slot(path):
    """Lock a slot's file without waiting, and report whether this check now holds it.

    The descriptor stays open, so the check holds the slot until it exits. The
    system releases the lock when the process ends, however it ends, and the
    check's child processes do not inherit the descriptor.
    """
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o666)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        # lockf(1) removes its lock file when its command ends, so a file
        # opened just before that can lock after another check has made a
        # new one at the path. Such a lock holds nothing.
        locked = os.fstat(descriptor)
        current = os.stat(path)
        if (locked.st_dev, locked.st_ino) == (current.st_dev, current.st_ino):
            return True
    except (BlockingIOError, FileNotFoundError):
        pass
    os.close(descriptor)
    return False


def take_slot():
    """Wait for one of the Mac's SLOTS check slots, and hold it until this process exits."""
    started = time.monotonic()
    waiting = False
    while True:
        for number in range(1, SLOTS + 1):
            if lock_slot(SLOT_DIRECTORY / f"screenr-check-ios-slot-{number}.lock"):
                waited = f" after waiting {(time.monotonic() - started) / 60:.1f} minutes" if waiting else ""
                print(f"Took iOS check slot {number} of {SLOTS}{waited}.", flush=True)
                return
        if not waiting:
            print(f"Waiting for an iOS check slot: all {SLOTS} are in use by other bin/check-ios runs "
                  "on this Mac.", flush=True)
            waiting = True
        time.sleep(SLOT_POLL_SECONDS)


def clear_stale_package_builds():
    """Remove PACKAGE_BUILDS unless the stamp shows they were built with these packages and sources.

    Output without a stamp predates it, so it may come from any packages.
    """
    sources = packages.sources(ROOT)
    built_with = f"{packages.pins(ROOT)} {sources}"
    try:
        if PACKAGE_STAMP.read_text().strip() == built_with:
            return
    except FileNotFoundError:
        pass
    if any(path.exists() for path in PACKAGE_BUILDS):
        names = " and ".join(str(path.relative_to(ROOT)) for path in PACKAGE_BUILDS)
        print(f"Removing {names}: nothing records that they were built with this {packages.RESOLVED} "
              f"and the package sources in {sources}.", flush=True)
        for path in PACKAGE_BUILDS:
            if path.exists():
                shutil.rmtree(path)
    BUILD.mkdir(parents=True, exist_ok=True)
    PACKAGE_STAMP.write_text(built_with + "\n")


def ended(pid):
    """Report whether no process has this ID, so the check that had it has ended.

    An ID that another user's process holds, or that no process could have,
    does not count as ended.
    """
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except (PermissionError, OverflowError):
        pass
    return False


def delete_left_behind_simulators():
    """Delete the Simulators of earlier checks whose processes have ended.

    A check stopped with SIGKILL never deletes its Simulator, and neither does
    one whose simctl delete failed or outlasted its time limit. A Simulator
    whose check's process ID is in use is left alone, since it may be another
    checkout's running check; a reused ID only delays its deletion until a
    later check. Simulators that no check named, such as other projects', are
    never touched.
    """
    listing = json.loads(capture("xcrun", "simctl", "list", "--json", "devices"))
    for devices in listing.get("devices", {}).values():
        for device in devices:
            check = CHECK_SIMULATOR.fullmatch(device.get("name", ""))
            if check and ended(int(check["pid"])) and delete_simulator(device["udid"]):
                print(f"Deleted Simulator {device['name']} ({device['udid']}), which an earlier check left "
                      f"behind: its process {check['pid']} has ended.", flush=True)


def create_simulator():
    """Create an iPhone Simulator on the newest iOS runtime and return its UDID.

    It first deletes the Simulators that earlier checks left behind.
    """
    delete_left_behind_simulators()
    listing = json.loads(capture("xcrun", "simctl", "list", "--json", "runtimes"))
    runtimes = [runtime for runtime in listing.get("runtimes", [])
                if runtime.get("platform") == "iOS" and runtime.get("isAvailable")]
    version = lambda runtime: tuple(int(part) for part in runtime["version"].split("."))
    runtime = max(runtimes, key=version, default=None)
    if runtime is None or version(runtime)[0] < MINIMUM_XCODE:
        raise CheckFailure(f"An iOS {MINIMUM_XCODE} or later Simulator runtime is required. "
                           "Install one with: xcodebuild -downloadPlatform iOS")
    iphones = [kind for kind in runtime.get("supportedDeviceTypes", [])
               if kind.get("productFamily") == "iPhone"]
    if not iphones:
        raise CheckFailure(f"{runtime['name']} supports no iPhone Simulator.")
    name = f"screenr-check-{ROOT.name}-{os.getpid()}"
    udid = capture("xcrun", "simctl", "create", name, iphones[0]["identifier"],
                   runtime["identifier"]).strip()
    print(f"Created {iphones[0]['name']} Simulator {name} ({udid}) on {runtime['name']}.", flush=True)
    return udid


def delete_simulator(udid):
    """Shut down and delete a Simulator, report what simctl could not do, and return whether it is deleted.

    It runs after every Simulator test run, passing or failing, so it never
    raises: a Simulator left behind does not change the check's result.
    """
    for action in ("shutdown", "delete"):
        command = ["xcrun", "simctl", action, udid]
        try:
            result = call(command)
        except subprocess.TimeoutExpired:
            problem = stopped(command)
        else:
            # Shutting down a Simulator that never booted fails, and the delete still works.
            if action == "shutdown" or result.returncode == 0:
                continue
            problem = (f"{shlex.join(command)} failed with status {result.returncode}: "
                       f"{(result.stdout + result.stderr).strip()}")
        print(problem, file=sys.stderr, flush=True)
        if action == "delete":
            print(f"Simulator {udid} was not deleted. Delete it with: xcrun simctl delete {udid}",
                  file=sys.stderr, flush=True)
            return False
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--simulator", metavar="UDID",
                        help="run the Simulator tests on this existing Simulator, which is left in place")
    parser.add_argument("--reuse", action="store_true",
                        help="skip the check when these exact iOS files passed it with this Xcode "
                             f"in the last {records.LIFETIME.days} days")
    parser.add_argument("--test-timeout", type=float, default=TEST_TIMEOUT_MINUTES, metavar="MINUTES",
                        help="stop the Simulator tests and fail after this many minutes "
                             f"(default {TEST_TIMEOUT_MINUTES})")
    args = parser.parse_args()
    if args.test_timeout <= 0:
        parser.error("--test-timeout must be positive")
    if not shutil.which("xcodebuild"):
        raise CheckFailure("bin/check-ios needs macOS with Xcode 27 or later.")
    xcode = capture("xcodebuild", "-version")
    version = re.match(r"Xcode (\d+)", xcode)
    if not version or int(version[1]) < MINIMUM_XCODE:
        raise CheckFailure(f"Xcode {MINIMUM_XCODE} or later is required. Select it with xcode-select "
                           "or DEVELOPER_DIR.")
    xcode = " ".join(xcode.split())
    key = records.working_key(ROOT)
    found = records.passed(ROOT, key, xcode) if args.reuse else None
    if found:
        print(f"iOS checks already passed for these iOS files with {xcode} at {found['passedAt']} "
              f"in {found.get('checkout')}; skipping. Run bin/check-ios without --reuse to check again.",
              flush=True)
        return
    take_slot()
    clear_stale_package_builds()
    shutil.rmtree(OUTPUT, ignore_errors=True)
    OUTPUT.mkdir(parents=True)
    packages.use(ROOT, lambda command: run("Package resolution", command, packages.RESOLVE_TIMEOUT_MINUTES))
    run("ScreenrKit tests", ["swift", "test", "--package-path", "ios/ScreenrKit",
                             "--scratch-path", str(BUILD / "ScreenrKit"), *packages.swift_options()],
        BUILD_TIMEOUT_MINUTES)
    packages.share_artifacts(ROOT)
    release = OUTPUT / "Release.xcresult"
    run("Release build", [*XCODEBUILD, "-configuration", "Release", "-destination",
                          "generic/platform=iOS Simulator", "-resultBundlePath", str(release), "build"],
        BUILD_TIMEOUT_MINUTES)
    check_results("Release build", release, tests=False)
    udid = args.simulator or create_simulator()
    try:
        # A new Simulator keeps setting itself up after xcodebuild boots it, and
        # on a slow Mac that can outlast a UI test's app launch timeout.
        run("Simulator boot", ["xcrun", "simctl", "bootstatus", udid, "-b"], BOOT_TIMEOUT_MINUTES)
        # A Simulator covers its keyboard once, at an early keyboard appearance,
        # with an introduction to sliding across the letters, which a test's tap
        # there then misses, such as Post in a push's reply field. Which test
        # meets it depends on every earlier test's keyboard, so it never shows.
        capture("xcrun", "simctl", "spawn", udid, "defaults", "write", "com.apple.keyboard.preferences",
                "DidShowContinuousPathIntroduction", "-bool", "true")
        tests = OUTPUT / "Tests.xcresult"
        # Collecting diagnostics after a failed UI test took about 10 minutes
        # and sometimes never finished.
        # xcodebuild passes TEST_RUNNER_ variables to the tests without the prefix.
        with PushRelay(udid):
            run("Simulator tests", [*XCODEBUILD, "-configuration", "Debug", "-destination",
                                    f"platform=iOS Simulator,id={udid}", "-parallel-testing-enabled", "NO",
                                    "-collect-test-diagnostics", "never",
                                    "-resultBundlePath", str(tests), "test"], args.test_timeout,
                {"TEST_RUNNER_SCREENR_PUSH_RELAY": str(PUSH_RELAY)})
        check_results("Simulator tests", tests, tests=True)
    finally:
        if not args.simulator:
            delete_simulator(udid)
    print(f"iOS checks passed with no warnings. Logs and result bundles are in {OUTPUT}.", flush=True)
    if key and records.working_key(ROOT) == key:
        try:
            records.record(ROOT, key, xcode)
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"This pass could not be recorded for reuse: {error}", flush=True)
            return
        print("Recorded this pass for these iOS files; bin/check-ios --reuse and pushes of them "
              "will not run the check again.", flush=True)
    else:
        print("This pass is not recorded for reuse, since ios/ or bin/format-swift differs from HEAD "
              "or is not in Git.", flush=True)


def interrupt(signum, frame):
    raise KeyboardInterrupt


if __name__ == "__main__":
    # A terminated check stops its running step and deletes its Simulator, as Control-C does.
    signal.signal(signal.SIGTERM, interrupt)
    try:
        main()
    except KeyboardInterrupt:
        print("bin/check-ios stopped before it finished.", file=sys.stderr)
        sys.exit(130)
    except (CheckFailure, OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", None)
        print("\n".join(part for part in (str(error), detail) if part), file=sys.stderr)
        sys.exit(1)
