#!/usr/bin/env python3
"""Check repository scripts, document metadata, local links, and worktree behavior."""

import ast
from pathlib import Path
import re
import shutil
import subprocess
import sys
from urllib.parse import unquote, urlsplit


def main():
    root = Path(__file__).resolve().parent.parent
    if shutil.which("shellcheck") is None:
        print("ShellCheck is required. Install it, then run bin/check again.", file=sys.stderr)
        return 1
    output = subprocess.check_output(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=root,
    )
    files = sorted({root / path for path in output.decode().split("\0") if path})
    files = [path for path in files if path.is_file()]
    shell_files = [root / ".envrc", root / "bin/setup", root / "bin/prep-worktree", *sorted((root / "bin/hooks").iterdir())]
    subprocess.run(["shellcheck", "--shell=sh", *map(str, shell_files)], cwd=root, check=True)
    errors = []
    for path in files:
        if path.suffix == ".py" or path in (root / "bin/check", root / "bin/qmd-index"):
            ast.parse(path.read_text(), filename=str(path.relative_to(root)))
        if path.suffix != ".md":
            continue
        relative = path.relative_to(root)
        text = path.read_text()
        if relative.parts[:2] == ("memory", "pr_reviews"):
            continue
        if relative.parts[0] in ("memory", "docs") and path.name != "README.md":
            frontmatter = re.match(r"\A---\n(.*?)\n---(?:\n|$)", text, re.S)
            if not frontmatter:
                errors.append(f"{relative}: missing YAML frontmatter")
            else:
                fields = {}
                for line in frontmatter[1].splitlines():
                    match = re.match(r"^(\w+):\s*(.*?)\s*$", line)
                    if match:
                        key, value = match.groups()
                        if key in fields:
                            errors.append(f"{relative}: duplicate {key} field")
                        fields[key] = value.strip("\"'")
                if relative.parts[0] == "docs":
                    if fields.get("status") not in {"planning", "in-progress", "shipped", "blocked", "abandoned"}:
                        errors.append(f"{relative}: invalid document status")
                else:
                    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", fields.get("name", "")):
                        errors.append(f"{relative}: invalid memory name")
                    if not fields.get("description") or fields["description"] in {"|", ">", "|-", ">-"}:
                        errors.append(f"{relative}: description must be a nonempty one-line scalar")
                    if fields.get("type") not in {"user", "feedback", "project", "reference"}:
                        errors.append(f"{relative}: invalid memory type")
                    if fields.get("type") == "project":
                        expected = "resolved" if "archive" in relative.parts else "active"
                        if fields.get("status") != expected:
                            errors.append(f"{relative}: project status must be {expected}")
                    elif "status" in fields:
                        errors.append(f"{relative}: status is only used on project memories")
        # Check file destinations outside fenced code. Remote URLs need no network.
        prose = re.sub(r"(?ms)^(`{3,}|~{3,}).*?^\1\s*$", "", text)
        targets = re.findall(r"\]\(\s*(<[^>]+>|[^\s)]+)", prose)
        targets += re.findall(r"(?m)^\s*\[[^\]]+\]:\s*(<[^>]+>|\S+)", prose)
        for target in targets:
            target = target.strip("<>")
            parsed = urlsplit(target)
            if parsed.scheme or parsed.netloc or not parsed.path:
                continue
            destination = path.parent / unquote(parsed.path)
            if not destination.exists():
                errors.append(f"{relative}: missing link destination {target}")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print("Script syntax, document metadata, and local file links passed.", flush=True)
    subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"],
        cwd=root, check=True,
    )
    subprocess.run(["git", "diff", "--check"], cwd=root, check=True)
    subprocess.run(["git", "diff", "--cached", "--check"], cwd=root, check=True)
    print("Repository checks passed.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (subprocess.CalledProcessError, SyntaxError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
