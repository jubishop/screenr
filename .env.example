# Copy to .env for local setup. This example is tracked; real credentials are not.
# Keep every operator-supplied setting represented here when configuration changes.

# Local PostgreSQL, set up as docs/running-screenr.md#local-setup describes.
# Production uses its own database role and random password.
DATABASE_URL=postgresql://screenr:screenr-local-only@127.0.0.1:5439/screenr

# Application URL and authentication secret.
# Production URL: https://screenr.club
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth Web application credentials. The project ID/number is not used here.
# Configure the callback URLs documented in docs/running-screenr.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional iPhone app provider settings, described in docs/running-screenr.md.
# Each private key is the single-line base64 body of its .p8 file, without the
# PEM header and footer.
GOOGLE_IOS_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
# Optional. iPhone app builds below this whole number get HTTP 426 and must
# update. Leave empty to serve every build. See docs/data-and-access.md.
SCREENR_IOS_MINIMUM_BUILD=

# TMDB API Read Access Token. The separate API Key is not used by Screenr.
TMDB_READ_TOKEN=

# Development: file captures codes in .cache/mail without sending email.
# Production: resend requires the verified sender and sending API key below.
EMAIL_TRANSPORT=file
EMAIL_FROM="Screenr <screenr@jubishop.com>"
RESEND_API_KEY=

# Optional DSN of the screenr-server Sentry project. Production reports server
# failures there; leave it empty to keep failures in the local log only.
SENTRY_DSN=

# Production only: the six-digit sign-in code for Apple's beta review account.
# Leave it empty locally. See docs/running-screenr.md#demo-circle-for-apple-review.
REVIEW_SIGN_IN_CODE=

# Optional encrypted VPS backups. These settings are used by the backup jobs.
# On the server, put them in /etc/screenr/backup.env, separate from app.env.
# Keep this section in sync with ops/backup.env.example.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/screenr-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=
# Also copy EMAIL_FROM and RESEND_API_KEY above into backup.env for size warnings.
BACKUP_ALERT_TO=

# Optional, this Mac only: Screenr's own Anthropic API key for the weekly
# memory audit, which uses the Claude subscription without it. Never copy it
# into app.env. See docs/foundation/memory-audit.md#api-key.
MEMORY_AUDIT_ANTHROPIC_API_KEY=
