# Root-owned mode 0600. Never commit actual credentials or the password.
# Use an R2 object credential restricted to the private Screenr backup bucket.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/screenr-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=

# Warn once above 1 GB, then rearm below 1 GB. Required by the daily size check.
# Use the existing verified Screenr sender and a sending-only Resend key.
EMAIL_FROM="Screenr <screenr@jubishop.com>"
RESEND_API_KEY=
BACKUP_ALERT_TO=
