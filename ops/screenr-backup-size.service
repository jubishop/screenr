[Unit]
Description=Screenr backup storage size check
# A run that starts during a backup waits until its upload and prune finish.
After=network-online.target screenr-backup.service
OnFailure=screenr-alert@%n.service

[Service]
Type=oneshot
User=screenr-db
Group=screenr-db
EnvironmentFile=/etc/screenr/backup.env
ExecStart=/usr/bin/python3 /opt/screenr/current/ops/check-backup-size.py
StateDirectory=screenr-backup
StateDirectoryMode=0700
MemoryMax=256M
CPUQuota=25%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/screenr-backup
UMask=0077
