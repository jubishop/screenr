[Unit]
Description=Screenr encrypted off-server database backup
After=network-online.target screenr-db.service
Wants=network-online.target
Requires=screenr-db.service
OnFailure=screenr-alert@%n.service

[Service]
Type=oneshot
# Deployments wait for this backup while holding the deploy lock. Stop a
# hung run inside the 20-minute deploy job; the timeout fails the unit.
TimeoutStartSec=15min
User=screenr-db
Group=screenr-db
EnvironmentFile=/etc/screenr/backup.env
ExecStart=/bin/sh /opt/screenr/current/ops/backup.sh
StateDirectory=screenr-backup
StateDirectoryMode=0700
MemoryMax=256M
CPUQuota=25%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/screenr-backup
UMask=0077
