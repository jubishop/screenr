[Unit]
Description=Screenr encrypted off-server database backup
After=network-online.target screenr-db.service
Wants=network-online.target
Requires=screenr-db.service
OnFailure=screenr-alert@%n.service

[Service]
Type=oneshot
# Deployments wait for this backup while holding the deploy lock. Stop a
# hung run inside the 20-minute deploy job; the timeout fails the unit.
TimeoutStartSec=15min
User=screenr-db
Group=screenr-db
EnvironmentFile=/etc/screenr/backup.env
ExecStart=/bin/sh /usr/local/lib/screenr-deploy/backup.sh
StateDirectory=screenr-backup
StateDirectoryMode=0700
MemoryMax=256M
CPUQuota=25%
Nice=10
# The worker's sandbox; tests/test_app_sandbox.py keeps every copy the same.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
# The database socket and HTTPS to R2 need only these families.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# Other applications on the shared host. '-' ignores a path that is missing.
InaccessiblePaths=-/etc/caddy -/var/log/caddy -/opt/health -/opt/health-site -/opt/kidsbank -/opt/news -/opt/trading
ReadWritePaths=/var/lib/screenr-backup
UMask=0077
