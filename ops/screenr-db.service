[Unit]
Description=Screenr isolated PostgreSQL cluster
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=screenr-alert@%n.service

[Service]
# PostgreSQL tells systemd when it accepts connections, so the units that
# require this one start only then. Crash recovery can outlast systemd's
# 90-second default, and a start timeout would restart recovery from the
# beginning.
Type=notify
TimeoutStartSec=infinity
User=screenr-db
Group=screenr-db
RuntimeDirectory=screenr-db
RuntimeDirectoryMode=0750
ExecStart=/usr/lib/postgresql/18/bin/postgres -D /var/lib/screenr/postgres
ExecReload=/bin/kill -HUP $MAINPID
# Stopping sends SIGINT, PostgreSQL's fast shutdown, only to the postmaster,
# which stops its child processes in order. systemd kills any that remain
# after the stop timeout.
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
MemoryHigh=220M
MemoryMax=256M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/screenr/postgres /run/screenr-db
UMask=0077

[Install]
WantedBy=multi-user.target
