[Unit]
Description=Screenr failure alert for %i
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/screenr/backup.env
ExecStart=/usr/bin/python3 /opt/screenr/current/ops/failure-alert.py %i
MemoryMax=64M
CPUQuota=25%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
