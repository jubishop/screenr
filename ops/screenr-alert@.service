[Unit]
Description=Screenr failure alert for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A dynamic user cannot reach systemd's D-Bus API on the host.
User=screenr-db
Group=screenr-db
EnvironmentFile=/etc/screenr/backup.env
ExecStart=/usr/bin/python3 /usr/local/lib/screenr-deploy/failure-alert.py %i
MemoryMax=64M
CPUQuota=25%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
