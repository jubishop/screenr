# Install both sites together after the domain cutover prerequisites in
# docs/deployment.md are complete. Preserve all unrelated sites.
screenr.club {
    tls /etc/caddy/certs/screenr-club.pem /etc/caddy/certs/screenr-club.key
    encode zstd gzip
    request_body {
        max_size 64KB
    }
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }
    reverse_proxy 127.0.0.1:3060 {
        # The existing firewall accepts HTTP(S) only from Cloudflare.
        # Overwrite the address used by Better Auth's rate limiter.
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
    }
}

# Keep old shared invitation and title URLs working. Retain the old certificate
# and proxied DNS record; TLS must succeed before the browser can redirect.
screenr.jubishop.com {
    tls /etc/caddy/certs/screenr.pem /etc/caddy/certs/screenr.key
    header {
        Referrer-Policy "no-referrer"
        # Allow rollback without leaving a cached cross-domain redirect.
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }
    redir https://screenr.club{uri} 308
}
