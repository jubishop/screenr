[Unit]
Description=Screenr web application
After=network-online.target screenr-db.service
Wants=network-online.target
Requires=screenr-db.service
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=screenr-alert@%n.service

[Service]
User=screenr
Group=screenr
WorkingDirectory=/opt/screenr/current
EnvironmentFile=/etc/screenr/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3060
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/opt/screenr/node/bin/node server.js
# Next reports a graceful SIGTERM shutdown as exit code 143.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
MemoryHigh=320M
MemoryMax=384M
CPUQuota=100%
# The web and worker units share this sandbox; only the web writes files.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
# Loopback PostgreSQL and HTTPS to Resend and TMDB need only these families.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute stays off because V8's JIT writes executable memory.
SystemCallFilter=@system-service
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# Other applications on the shared host. '-' ignores a path that is missing.
InaccessiblePaths=-/etc/caddy -/var/log/caddy -/opt/health -/opt/health-site -/opt/kidsbank -/opt/news -/opt/trading
ReadWritePaths=/opt/screenr/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
