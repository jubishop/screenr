[Unit]
Description=Screenr web application
After=network-online.target screenr-db.service
Requires=screenr-db.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=screenr
Group=screenr
WorkingDirectory=/opt/screenr/current
EnvironmentFile=/etc/screenr/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3060
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/opt/screenr/node/bin/node server.js
# Next reports a graceful SIGTERM shutdown as exit code 143.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
MemoryHigh=320M
MemoryMax=384M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/screenr/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
