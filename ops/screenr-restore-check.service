[Unit]
Description=Screenr backup restore verification
After=network-online.target screenr-db.service
Wants=network-online.target
Requires=screenr-db.service
OnFailure=screenr-alert@%n.service

[Service]
Type=oneshot
# Stop a hung run, which also releases its exclusive restic lock.
TimeoutStartSec=30min
User=screenr-db
Group=screenr-db
EnvironmentFile=/etc/screenr/backup.env
ExecStart=/bin/sh /opt/screenr/current/ops/restore-check.sh
StateDirectory=screenr-backup
StateDirectoryMode=0700
MemoryMax=256M
CPUQuota=25%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/screenr-backup
UMask=0077
