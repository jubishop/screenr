[Unit]
Description=Screenr pending PostgreSQL update check
After=network-online.target
Wants=network-online.target
OnFailure=screenr-alert@%n.service

[Service]
Type=oneshot
# Reads only apt package lists and its own state, so it needs no Screenr user.
DynamicUser=yes
EnvironmentFile=/etc/screenr/backup.env
ExecStart=/usr/bin/python3 /usr/local/lib/screenr-deploy/check-postgresql-updates.py
StateDirectory=screenr-postgresql-updates
StateDirectoryMode=0700
MemoryMax=256M
CPUQuota=25%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
