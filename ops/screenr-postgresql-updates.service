[Unit]
Description=Install Screenr's pending PostgreSQL repository updates
After=network-online.target
Wants=network-online.target
OnFailure=screenr-alert@%n.service

[Service]
Type=oneshot
# apt and dpkg run as root and write system directories, so unlike Screenr's
# other jobs this unit has no sandbox. It runs only the root-installed kit
# script and system programs, never release code.
ExecStart=/usr/bin/python3 -I /usr/local/lib/screenr-deploy/update-postgresql.py
# The deploy key's postgresql-status command reads status.json here.
StateDirectory=screenr-postgresql-updates
# Above the sum of the script's own step limits, so systemd never stops dpkg
# before the script does.
TimeoutStartSec=3h
Nice=10
